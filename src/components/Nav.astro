---
// Top navigation bar. Highlights the active route.
const { pathname } = Astro.url;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  { href: `${base}/about`,    label: 'About' },
  { href: `${base}/projects`, label: 'Projects & Simulations' },
  { href: `${base}/resume`,   label: 'Resume' },
  { href: `${base}/contact`,  label: 'Contact' },
];

const homeHref = `${base}/`;
const normalizedPath = pathname.replace(/\/$/, '');
const normalizedHome = base || '';
const isHome = normalizedPath === normalizedHome;
const navState = isHome ? 'home' : 'inner';
const leftLinks = links.slice(0, 2);
const rightLinks = links.slice(2);

function isActive(href: string): boolean {
  // Normalize trailing slashes for comparison
  const a = href.replace(/\/$/, '');
  const b = pathname.replace(/\/$/, '');
  if (a === b) return true;
  // Active for nested routes (e.g. /projects/foo highlights "Projects")
  return b.startsWith(a + '/');
}
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-bg/70 backdrop-blur-md">
  <nav class="container-wide site-nav">
    <div class="nav-orbit" data-state={navState}>
      <ul class="nav-group nav-group-left" transition:name="nav-left-links">
        {leftLinks.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-2 py-1 font-mono text-xs uppercase tracking-wider transition-colors sm:px-3 sm:text-sm',
                isActive(l.href)
                  ? 'text-accent'
                  : 'text-muted hover:text-text',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href={homeHref}
        aria-hidden={isHome ? 'true' : undefined}
        tabindex={isHome ? -1 : undefined}
        class="nav-home-link whitespace-nowrap font-mono text-sm tracking-wide text-text hover:text-accent"
        transition:name="nav-home-link"
      >
        <span class="text-accent">{'>'}</span> Daniel Araya
      </a>
      <ul class="nav-group nav-group-right" transition:name="nav-right-links">
        {rightLinks.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={isActive(l.href) ? 'page' : undefined}
              class:list={[
                'rounded-md px-2 py-1 font-mono text-xs uppercase tracking-wider transition-colors sm:px-3 sm:text-sm',
                isActive(l.href)
                  ? 'text-accent'
                  : 'text-muted hover:text-text',
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </nav>
</header>

<style>
  .site-nav {
    min-height: 3.5rem;
    padding-block: 0.75rem;
  }

  .nav-orbit {
    --nav-home-width: 0rem;
    --nav-column-gap: 0.125rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--nav-home-width) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--nav-column-gap);
    row-gap: 0.5rem;
    transition:
      grid-template-columns 520ms cubic-bezier(0.22, 1, 0.36, 1),
      column-gap 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-orbit[data-state='inner'] {
    --nav-home-width: 9.75rem;
    --nav-column-gap: 0.75rem;
  }

  .nav-group {
    display: flex;
    min-width: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.25rem;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-group-left {
    justify-content: flex-end;
  }

  .nav-group-right {
    justify-content: flex-start;
  }

  .nav-home-link {
    width: 9.75rem;
    justify-self: center;
    text-align: center;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      color 180ms ease,
      opacity 260ms ease,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-orbit[data-state='home'] .nav-home-link {
    pointer-events: none;
    opacity: 0;
    transform: translateY(-0.35rem) scale(0.96);
  }

  @media (max-width: 639px) {
    .site-nav {
      padding-block: 0.625rem;
    }

    .nav-orbit,
    .nav-orbit[data-state='inner'] {
      --nav-column-gap: 0rem;
      grid-template-columns: minmax(0, 1fr);
    }

    .nav-home-link {
      grid-row: 1;
      width: auto;
      max-height: 2rem;
      overflow: hidden;
    }

    .nav-orbit[data-state='home'] .nav-home-link {
      position: absolute;
      max-height: 0;
    }

    .nav-group-left {
      grid-row: 2;
      justify-content: center;
    }

    .nav-group-right {
      grid-row: 3;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-orbit,
    .nav-group,
    .nav-home-link {
      transition: none;
    }
  }
</style>
